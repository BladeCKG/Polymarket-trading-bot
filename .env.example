# ═══════════════════════════════════════════════════════════════════════════
# TRADING MODE — pick which bot `npm start` launches
# ═══════════════════════════════════════════════════════════════════════════
#   arb  → 9-rule BTC Up/Down auto-trading strategy (default)
#   copy → BUY-only copy trader that mirrors COPY_TARGETS below
#   value -> value-polling leg builder for short-duration crypto up/down markets
TRADING_MODE=arb

# ── Wallet ──────────────────────────────────────────────────────────────────
# Your Polygon EOA private key (controls the Polymarket proxy wallet).
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# The Polymarket proxy wallet address associated with your account.
# Retrieve from https://polymarket.com after connecting your wallet.
PROXY_WALLET=0xYOUR_PROXY_WALLET_HERE

# ── Polymarket CLOB API credentials ─────────────────────────────────────────
# Leave blank on first run; the bot derives them via L1 auth (see Polymarket docs).
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# EIP-712 signature type: 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE, 3=POLY_1271 (deposit wallet).
# https://docs.polymarket.com/api-reference/authentication#signature-types-and-funder
# SIGNATURE_TYPE=2

# POST /heartbeats interval (ms) while GTC ladder orders rest. Min 10000. Default 30000.
# HEARTBEAT_INTERVAL_MS=30000

# ── Polygon RPC ──────────────────────────────────────────────────────────────
# Use a private endpoint (Alchemy / Infura / QuickNode) for reliability.
POLYGON_RPC=https://polygon-rpc.com
# Optional WebSocket RPC for direct on-chain copy-trade monitoring.
# Required only when COPY_FEED_MODE=CHAIN.
POLYGON_WS_RPC=wss://your-polygon-ws-endpoint

# ── Risk parameters ──────────────────────────────────────────────────────────
# Maximum USDC to spend (buy-side) in a single 5-min market.
MAX_SPEND_PER_MARKET=400

# Stop buying the over-held side when |Up_shares - Down_shares| exceeds this USDC value.
MAX_INVENTORY_IMBALANCE_USDC=200

# Minimum arb edge required before firing a taker buy (Rule 3).
# 0.02 = at least 2c net per pair after gas.
TARGET_EDGE=0.02

# Minimum matched pairs (in USDC equivalent) before calling mergePositions (Rule 4).
# Keep >= 10 to amortise gas.
MERGE_THRESHOLD_USDC=15

# Maximum size per individual taker fill, in USDC.
MAX_TAKER_FILL_USDC=100

# Combined-ask circuit-breaker: pull orders if best_ask_up + best_ask_down > this.
COMBINED_ASK_STOP=1.02

# Max cumulative realized loss per hour before halting the bot.
MAX_LOSS_PER_HOUR_USDC=300

# ── Ladder parameters ────────────────────────────────────────────────────────
# Comma-separated list of round-cent price levels for both Up and Down.
LADDER_LEVELS=0.02,0.05,0.10,0.15,0.20,0.25,0.30,0.35,0.40,0.45,0.48,0.50,0.52,0.55,0.60,0.65,0.70,0.75,0.80,0.85,0.90,0.95,0.98

# USDC to allocate per ladder level per side.
LADDER_SIZE_PER_LEVEL_USDC=20

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════
# BUY-ONLY COPY TRADER (`npm run copy`) — optional; ignored by the arb bot
# ═══════════════════════════════════════════════════════════════════════════

# Comma-separated Polymarket proxy-wallet addresses to mirror.
# Example: the wallet you've been reverse-engineering.
COPY_TARGETS=0xcfb103c37c0234f524c632d964ed31f117b5f694

# Sizing mode: FIXED | MIRROR | RATIO
#   FIXED  — always spend exactly COPY_FIXED_USDC per copied trade
#   MIRROR — spend the same USDC the target spent
#   RATIO  — spend COPY_RATIO × target's USDC
COPY_SIZE_MODE=FIXED
COPY_FIXED_USDC=10
COPY_RATIO=0.10

# Execution caps (USDC)
COPY_MAX_USDC_PER_TRADE=50
COPY_MAX_USDC_PER_MARKET=200
COPY_MAX_USDC_PER_HOUR=500
COPY_MAX_USDC_TOTAL=2000

# Slippage / price guardrails
COPY_MAX_SLIPPAGE=0.03
COPY_MAX_PRICE=0.97
COPY_MIN_PRICE=0.02

# Drop trades older than this (ms) at detection time — don't chase stale signal.
COPY_STALE_MS=8000

# Poll interval per target (ms). 250ms = ~4 req/s per wallet.
COPY_POLL_MS=250

# Signal source: REST uses Polymarket's public /trades API, CHAIN listens for
# live OrderFilled logs on Polygon and enriches them with Gamma metadata.
COPY_FEED_MODE=REST

# Settled target-wallet PnL source:
#   API      -> reconstruct from Polymarket Data API market-scoped trades
#   OBSERVED -> reconstruct only from trades the bot observed during this run
#   AUTO     -> prefer observed trades, fall back to API
COPY_SETTLED_TRADER_PNL_SOURCE=API

# Optional allow/block lists (comma-separated 0x-prefixed conditionIds).
# Leave COPY_ALLOWED_CONDITIONS empty to copy any market the target trades.
COPY_ALLOWED_CONDITIONS=
COPY_BLOCKED_CONDITIONS=

# Set true to log everything without actually sending orders.
COPY_DRY_RUN=false

# VALUE POLLING STRATEGY (`npm run value`) - separate runtime and dashboard

# Dry-run is enabled by default for this strategy. Set false to send real buys.
VALUE_DRY_RUN=true

# Poll interval for live books and market state.
VALUE_POLL_MS=1000

# How often to refresh the active short-duration market list from Gamma.
VALUE_MARKET_REFRESH_MS=15000

# Symbols / durations to watch.
VALUE_SYMBOLS=btc,eth,sol,xrp,bnb,doge
VALUE_DURATIONS=5m,15m

# Entry band for best ask polling.
VALUE_ENTRY_MIN_PRICE=0.40
VALUE_ENTRY_MAX_PRICE=0.45

# Max slippage added to the current best ask when constructing a buy.
VALUE_MAX_SLIPPAGE=0.03

# Order sizing mode:
#   USDC   -> spend VALUE_LEG_USDC per leg
#   SHARES -> target VALUE_TARGET_SHARES per leg
VALUE_ORDER_MODE=USDC
VALUE_LEG_USDC=1
VALUE_TARGET_SHARES=5

# Stop opening a first leg this many seconds before the market closes.
VALUE_FIRST_LEG_CUTOFF_SECONDS=60

# Stop attempting the second leg this many seconds before the market closes.
VALUE_SECOND_LEG_CUTOFF_SECONDS=15

# Risk caps.
VALUE_MAX_OPEN_MARKETS=20
VALUE_MAX_STRANDED_LEGS=10

# Dedicated dashboard for this strategy.
VALUE_DASHBOARD_ENABLED=true
VALUE_DASHBOARD_HOST=127.0.0.1
VALUE_DASHBOARD_PORT=8797
